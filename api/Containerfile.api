# API Service Container for Tenant Management
# This container provides REST API endpoints for managing tenant configurations

FROM registry.access.redhat.com/ubi9

# Install Python and basic tools
RUN dnf install -y python3 python3-pip && \
    dnf clean all

# Set working directory
WORKDIR /var/task

# Install uv for fast Python package management
RUN pip3 install --no-cache-dir uv

# Copy dependency files first for better caching
COPY pyproject.toml uv.lock README.md ./

# Install Python dependencies using uv with frozen lockfile for reproducible builds
RUN uv sync --frozen --no-dev

# Copy API source code
COPY src/ ./src/

RUN if ! getent passwd 1001 >/dev/null; then useradd -u 1001 -r -s /sbin/nologin appuser; fi \
 && chown -R 1001:0 /var/task
USER 1001

# Set the Lambda handler using AWS Lambda Runtime Interface Client
ENTRYPOINT ["/var/task/.venv/bin/python", "-m", "awslambdaric", "src.app.lambda_handler"]

# Default to Lambda mode
CMD [""]
